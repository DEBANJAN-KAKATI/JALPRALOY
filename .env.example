# Copy to .env and fill in. Never commit .env.

# --- Database / cache ---
POSTGRES_USER=jalproloi
POSTGRES_PASSWORD=jalproloi
POSTGRES_DB=jalproloi
DATABASE_URL=postgresql+psycopg://jalproloi:jalproloi@localhost:5432/jalproloi
REDIS_URL=redis://localhost:6379/0

# --- Backend ---
# true = serve clearly-labelled synthetic data so the frontend works before models exist
DEMO_MODE=true
CORS_ORIGINS=["http://localhost:5173"]
CAP_SENDER=jalproloi@example.org
# Use "Exercise" for demos and hindcasts; "Actual" only for real operational alerts
CAP_STATUS=Exercise

# --- Data accounts (see docs/00_SETUP.md) ---
# NASA Earthdata (IMERG, SMAP). earthaccess reads these two variables.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Google Earth Engine Cloud project id (Sentinel-1, DEM, WorldCover, ERA5-Land)
GEE_PROJECT=
# Copernicus Climate Data Store (ERA5 / ERA5-Land if not using GEE)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
# ISRO MOSDAC (INSAT-3D/3DR rainfall)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# --- Alert channels ---
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Live sync (docs/12_LIVE_DATA_SYNC.md) ---
# Where the scheduler warms caches; in docker compose this is http://backend:8000
API_URL=http://localhost:8000
# Optional heartbeat URL (e.g. https://hc-ping.com/<uuid>) — emails you if sync stops
HEALTHCHECK_URL=

# Optional: override where data/ lives (e.g. an external drive)
# JALPROLOI_DATA=D:/jalproloi-data
